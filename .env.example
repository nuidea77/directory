APP_NAME="Ойрхон.mn"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://oirkhon.mn

APP_LOCALE=mn
APP_FALLBACK_LOCALE=mn
APP_TIMEZONE=Asia/Ulaanbaatar
APP_FAKER_LOCALE=mn_MN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=directory
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- verify.mn (MO SMS phone verification) -----------------------------------
# Get your API key from the verify.mn developer console.
# Set VERIFY_MN_ENABLED=false in local dev to auto-verify without real SMS.
VERIFY_MN_ENABLED=true
VERIFY_MN_API_KEY=
VERIFY_MN_BASE_URL=https://api.verify.mn

# --- byl.mn (payments: QPay, SocialPay, Pocket, Golomt) -----------------------
# API token, project id and webhook secret from the byl.mn dashboard.
BYL_API_TOKEN=
BYL_PROJECT_ID=
BYL_WEBHOOK_SECRET=
BYL_BASE_URL=https://byl.mn/api

# Sanctum токены хугацаа (минутаар, 86400 = 60 хоног)
SANCTUM_TOKEN_EXPIRATION=86400
# CORS: SPA болон мобайл аппын origin-ууд (таслалаар)
CORS_ALLOWED_ORIGINS="${APP_URL}"

# OpenStreetMap Nominatim — бүртгэлийн зургийг дүүрэг/сум, хороо руу ойртуулахад.
# Ашиглалтын нөхцлөөр өөрийн сайт, холбоо барих хаягаа заавал бичнэ.
NOMINATIM_USER_AGENT="Oirkhon.mn business directory (admin@oirkhon.mn)"

# Газрын зураг — Mapbox GL JS. Vite env тул өөрчилсний дараа npm run build.
#
# Mapbox — https://account.mapbox.com → Access tokens → pk.* public token.
# Token-оо "URL restrictions"-д өөрийн домэйноор хязгаарла (browser-т ил гардаг).
# Үнэгүй: сард 50,000 map load.
VITE_MAPBOX_TOKEN=
# Хэв маяг: mapbox/light-v11 (цайвар, цэвэрхэн), mapbox/streets-v12, mapbox/outdoors-v12,
# эсвэл Mapbox Studio-д өөрийн хэв маяг → "хэрэглэгч/style_id"
VITE_MAPBOX_STYLE=mapbox/light-v11
# Нуух давхаргууд (таслалаар). poi-label = дэлгүүр/ресторан шошго; барилга, зам,
# автобусны буудал (transit-label) хэвээр. Бүх шошгыг нуух бол: poi-label,transit-label
VITE_MAP_HIDE_LAYERS=poi-label
#
# Token байхгүй бол OSM raster руу буцна (POI icon-той, нуух боломжгүй).
# Өөр raster үйлчилгээ: VITE_MAP_TILES="https://.../{z}/{x}/{y}.png?key=…", VITE_MAP_ATTRIBUTION="…"
